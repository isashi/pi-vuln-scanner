{
  "name": "pi-vuln-scanner",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A pi extension that scans locally installed pi packages for vulnerabilities and supply-chain risk.",
  "homepage": "https://isashi.github.io/pi-vuln-scanner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isashi/pi-vuln-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/isashi/pi-vuln-scanner/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "security",
    "vulnerability-scanner",
    "developer-tools"
  ],
  "license": "MIT",
  "author": {
    "name": "isashi",
    "email": "isashimitsui@gmail.com"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm test && npm run audit"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
